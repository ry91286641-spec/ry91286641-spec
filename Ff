<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>OSINT Phone Tracker</title>
    <style>
        body { background-color: #0a0a0a; color: #00ff00; font-family: 'Courier New', monospace; display: flex; flex-direction: column; align-items: center; padding: 50px; }
        .box { border: 2px solid #00ff00; padding: 20px; border-radius: 10px; box-shadow: 0 0 20px #00ff00; width: 80%; max-width: 500px; }
        input { background: #1a1a1a; border: 1px solid #00ff00; color: #00ff00; padding: 10px; width: 90%; margin-bottom: 20px; }
        button { background: #00ff00; color: black; border: none; padding: 10px 20px; cursor: pointer; font-weight: bold; width: 100%; }
        #results { margin-top: 20px; white-space: pre-wrap; color: #61dafb; border-top: 1px solid #333; padding-top: 10px; }
        .header { color: #ff0000; text-shadow: 2px 2px black; }
    </style>
</head>
<body>
    <div class="box">
        <h1 class="header">SYSTEM_SCANNER v1.0</h1>
        <p>Enter Target Number (with +91):</p>
        <input type="text" id="phoneInput" placeholder="+919999999999">
        <button onclick="scanNumber()">RUN DEEP SCAN</button>
        <div id="results">Waiting for target...</div>
    </div>

    <script>
        async function scanNumber() {
            const number = document.getElementById('phoneInput').value;
            const resBox = document.getElementById('results');
            const apiKey = "7fed5741a3c44efebce6bd5c63d631e37fed5741a3c44efebce6bd5c63d631e37fed5741a3c44efebce6bd5c63d631e3"; // Apni key yahan daalein

            if(!number) { alert("Pehle number dalo!"); return; }
            
            resBox.innerText = "Scanning Database... Please wait...";
            
            try {
                const response = await fetch(`https://phonevalidation.abstractapi.com/v1/?api_key=${apiKey}&phone=${number}`);
                const data = await response.json();
                
                resBox.innerText = `
[SUCCESS] DATA FOUND:
--------------------------
Location: ${data.location || 'Unknown'}
Carrier:  ${data.carrier || 'Unknown'}
Type:     ${data.type || 'Unknown'}
Valid:    ${data.valid}
Format:   ${data.format.international}
--------------------------
Scan Complete.
                `;
            } catch (error) {
                resBox.innerText = "Error: API Key sahi nahi hai ya network issue hai.";
            }
        }
    </script>
</body>
</html>
